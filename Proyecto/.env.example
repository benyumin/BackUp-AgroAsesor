# Copia este archivo como .env (NO se sube a GitHub) y completa los valores reales.

# Base de datos oficial (Supabase/PostgreSQL)
DATABASE_URL=
DJANGO_SECRET_KEY=
# En producción DEBUG debe ser False. En Vercel, si esta variable falta, se asume False (y DJANGO_SECRET_KEY pasa
# a ser obligatoria: sin ella el sitio no arranca). En local, si falta, se asume True.
DJANGO_DEBUG=True
# HTTPS estricto (solo con DEBUG=False): segundos de HSTS (2592000 = 30 días; 0 lo desactiva) y si cubre subdominios.
DJANGO_HSTS_SEGUNDOS=2592000
DJANGO_HSTS_SUBDOMINIOS=false

# Límite de intentos (contadores en la caché compartida de la base, sin guardar IP ni correos en claro).
LIMITE_INTENTOS_ACTIVO=true
# Fallos de inicio de sesión por cuenta y por IP (ventana de 15 minutos).
LIMITE_LOGIN_CUENTA=8
LIMITE_LOGIN_IP=30
# Cuentas creadas por IP, solicitudes de recuperación por IP y correos de recuperación por dirección (por hora).
LIMITE_REGISTRO_IP=10
LIMITE_RECUPERAR_IP=10
LIMITE_RECUPERAR_CORREO=3

# Dirección pública HTTPS del sitio en producción, sin barra final y sin ruta (ej.: https://tu-dominio.vercel.app).
# Se usa para los enlaces de los correos y para la URL de retorno de Google. Deja vacío en desarrollo local.
SITE_URL=
# Vercel ya envía VERCEL=1 y Django lo detecta (confía en x-forwarded-proto para saber que la petición fue HTTPS).
# En otro proxy con HTTPS, pon true. No hace falta en local.
DJANGO_CONFIAR_PROXY_HTTPS=

# Inicio de sesión con Google (OAuth 2.0). Se obtienen en Google Cloud Console →
# APIs y servicios → Credenciales → «ID de cliente de OAuth» (tipo «Aplicación web»).
# Sin estos dos valores el botón «Continuar con Google» no aparece.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Opcional: URL exacta de retorno registrada en Google. Si se omite se usa SITE_URL + /cuenta/google/retorno/
# (o el dominio visitado). Debe ser idéntica, carácter por carácter, a la «URI de redireccionamiento autorizada».
GOOGLE_REDIRECT_URI=

# Google Maps JavaScript API (mapa de predios y potreros). Clave de navegador creada en Google Cloud Console →
# APIs y servicios → Credenciales. Restríngela a tus sitios (http://localhost:8000/*) y a «Maps JavaScript API».
# Sin este valor se usa el mapa de respaldo (OpenStreetMap).
GOOGLE_MAPS_API_KEY=
# Map ID propio (Google Cloud → Maps Management → Map IDs) para los marcadores avanzados. Si está vacío se usa
# DEMO_MAP_ID, válido solo para pruebas: en producción crea y define el tuyo.
GOOGLE_MAPS_MAP_ID=

# Recuperación de contraseña: correo saliente (SMTP de un proveedor transaccional; no uses cuentas personales).
# Sin EMAIL_HOST los correos solo se escriben en la terminal (desarrollo) y en producción se muestra un aviso de
# error en lugar de «solicitud recibida». Los valores los entrega el proveedor que elijas (Resend, Brevo, etc.).
EMAIL_HOST=
EMAIL_PORT=587
# Puerto 587 → STARTTLS (EMAIL_USE_TLS=true). Puerto 465 → SSL directo (se activa solo; o EMAIL_USE_SSL=true).
EMAIL_USE_TLS=true
EMAIL_USE_SSL=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_TIMEOUT=10
# Remitente verificado en el proveedor, ej.: AgroAsesor <no-responder@tu-dominio.cl>
DEFAULT_FROM_EMAIL=

# Pronóstico del tiempo (Open-Meteo). Todo es opcional; estos son los valores por defecto.
# Caché compartida entre predios y entre instancias (necesita la migración 0024: python manage.py migrate).
CLIMA_CACHE_COMPARTIDA=true
# Segundos que un pronóstico se considera reciente (900 = 15 min).
CLIMA_CACHE_SEGUNDOS=900
# Hasta cuántos segundos se puede mostrar un pronóstico antiguo (marcado como tal) si el proveedor falla (21600 = 6 h).
CLIMA_DATOS_ANTIGUOS_MAX_SEGUNDOS=21600
# Decimales de las coordenadas para compartir caché (2 ≈ 1 km: predios vecinos comparten la misma consulta).
CLIMA_PRECISION_COORDENADAS=2
CLIMA_TIMEOUT_SEGUNDOS=6
# Pausa compartida cuando Open-Meteo responde 429 sin indicar cuánto esperar, y tope máximo de pausa.
CLIMA_ESPERA_LIMITE_SEGUNDOS=120
CLIMA_ESPERA_LIMITE_MAX_SEGUNDOS=1800
# Segundos que espera una petición si otra ya está consultando las mismas coordenadas.
CLIMA_ESPERA_CONCURRENTE_SEGUNDOS=3
# Opcional: clave de pago de Open-Meteo (usa customer-api.open-meteo.com). Evita el límite por IP compartida de Vercel.
OPEN_METEO_API_KEY=
